# --- Required for production ---
NEXT_PUBLIC_SITE_URL=https://omnipathmarketing.com

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@omnipathmarketing.com
RESEND_NOTIFY_EMAIL=team@omnipathmarketing.com

# --- Cal.com ---
NEXT_PUBLIC_CALCOM_URL=https://cal.com/omnipath

# --- Plausible analytics (legacy, no-op if empty) ---
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Google Analytics 4 ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Notion CRM (optional - app works in no-op mode without these) ---
NOTION_API_KEY=secret_xxx
NOTION_LEADS_DB_ID=xxx

# --- Audit tool (optional - default is heuristic-only) ---
# PUPPETEER_SKIP_DOWNLOAD=true
# AUDIT_AHPREFS_API_KEY=
# AUDIT_SEMRUSH_API_KEY=

# --- Cloudflare Turnstile (anti-spam; form degrades gracefully if absent) ---
# Get keys at https://dash.cloudflare.com → Turnstile → Add widget
# Use "Managed" widget mode. Domains: omnipathmarketing.com, www.omnipathmarketing.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin portal password (optional; admin routes 404 if unset) ---
# When set, /admin/* becomes available with this password. Generate strong:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PASSWORD=
